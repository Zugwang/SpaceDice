# NASA API Key - Get yours at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# Flask
FLASK_ENV=production

# Secret key for Flask sessions (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-64-char-string

# Domain name (used in deploy scripts)
DOMAIN=spacedice.example.com

# Optional: admin token for /api/refresh endpoint
# ADMIN_TOKEN=
